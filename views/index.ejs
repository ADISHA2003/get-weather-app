<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather App</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 1rem;
            color: #f8fafc;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding-top: 2rem;
        }
        .search-card {
            background: rgba(255,255,255,0.12);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.2);
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            animation: fadeIn 0.6s;
        }
        .search-form { display: flex; gap: 0.75rem; }
        .search-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: none;
            border-radius: 16px;
            background: rgba(255,255,255,0.2);
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s ease;
        }
        .search-input::placeholder { color: rgba(255,255,255,0.7); }
        .search-input:focus { background: rgba(255,255,255,0.35); box-shadow: 0 0 0 2px #667eea55; }
        .search-btn {
            padding: 1rem;
            border: none;
            border-radius: 16px;
            background: #667eea;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .search-btn:hover, .search-btn:focus {
            background: #5a67d8;
            outline: none;
            transform: scale(1.05);
        }
        .search-btn svg { stroke: #fff; }
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(4, minmax(140px, auto));
            gap: 1rem;
            grid-template-areas:
                "main main temp temp"
                "main main feels humidity"
                "wind pressure clouds visibility"
                "sunrise sunset minmax minmax";
            animation: fadeIn 0.8s;
        }
        .bento-card {
            background: rgba(255,255,255,0.13);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.22);
            padding: 1.5rem;
            color: #f8fafc;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0,0,0,0.11);
            transition: transform 0.2s ease, box-shadow 0.2s;
            animation: fadeIn 1.2s;
        }
        .bento-card:hover { transform: translateY(-4px) scale(1.03); box-shadow: 0 16px 32px rgba(0,0,0,0.13);}
        .main-weather { grid-area: main; text-align: center; justify-content: center; align-items: center; }
        .city-name { font-size: 2rem; font-weight: 600; margin-bottom: 1rem; opacity: 0.93; letter-spacing: 1px;}
        .weather-icon-row { display: flex; align-items: center; justify-content: center; gap: 1.2rem; margin: 1rem 0;}
        .weather-icon { width: 100px; height: 100px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.2)); }
        .weather-description { font-size: 1.3rem; font-weight: 400; text-transform: capitalize; }
        .temp-card { text-align: center; justify-content: center; }
        .main-temp { font-size: 3.8rem; font-weight: 200; line-height: 1; }
        .temp-label { font-size: 0.95rem; opacity: 0.85; margin-top: 0.5rem; }
        .card-label { font-size: 0.87rem; opacity: 0.83; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.6px;}
        .card-value { font-size: 1.45rem; font-weight: 500;}
        .card-value.large { font-size: 2.05rem;}
        .minmax-card { flex-direction: row; align-items: center; gap: 2.2rem; }
        .minmax-item { flex: 1; text-align: center; }
        .minmax-temp { font-size: 1.8rem; font-weight: 500; margin-bottom: 0.25rem; }
        .minmax-label { font-size: 0.85rem; opacity: 0.82;}
        .error {
            background: rgba(255, 107, 107, 0.13);
            border: 1px solid rgba(255,107,107,0.38);
            border-radius: 20px;
            padding: 2rem;
            color: #ff6b6b;
            text-align: center;
            font-size: 1.18rem;
            font-weight: 500;
            margin-top: 2rem;
            backdrop-filter: blur(20px);
            animation: fadeIn 0.7s;
        }
        @media (max-width: 768px) {
            .bento-grid {
                grid-template-columns: repeat(2, 1fr);
                grid-template-rows: repeat(6, minmax(120px, auto));
                grid-template-areas:
                    "main main"
                    "temp feels"
                    "humidity wind"
                    "pressure clouds"
                    "visibility minmax"
                    "sunrise sunset";
            }
            .bento-card { margin-bottom: 8px; }
            .weather-icon { width: 80px; height: 80px;}
            .main-temp { font-size: 2.6rem;}
            .city-name { font-size: 1.3rem;}
        }
        @media (max-width: 480px) {
            .container { padding-top: 1rem;}
            .bento-grid {
                grid-template-columns: 1fr;
                grid-template-areas:
                    "main"
                    "temp"
                    "minmax"
                    "feels"
                    "humidity"
                    "wind"
                    "pressure"
                    "clouds"
                    "visibility"
                    "sunrise"
                    "sunset";
            }
            .minmax-card { flex-direction: row;}
            .bento-card { margin-bottom: 10px; }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px);}
            to { opacity: 1; transform: none;}
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="search-card">
            <form class="search-form" action="/weather" method="get" autocomplete="off">
                <input type="text" name="city" class="search-input" placeholder="Enter city name..." required aria-label="Enter city name">
                <button type="submit" class="search-btn" aria-label="Search for weather">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                </button>
            </form>
        </div>

        <% if (weather) { %>
        <div class="bento-grid">
            <div class="bento-card main-weather">
                <div class="city-name"><%= weather.city %>, <%= weather.country %></div>
                <div class="weather-icon-row">
                    <img src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png" 
                         alt="<%= weather.description %>" class="weather-icon" loading="lazy">
                    <div class="weather-description"><%= weather.description %></div>
                </div>
            </div>
            <div class="bento-card temp-card">
                <div class="card-label">Temperature</div>
                <div class="main-temp"><%= weather.temp %>°</div>
                <div class="temp-label">Celsius</div>
            </div>
            <div class="bento-card feels-card">
                <div class="card-label">Feels Like</div>
                <div class="card-value large"><%= weather.feels_like %>°</div>
            </div>
            <div class="bento-card humidity-card">
                <div class="card-label">Humidity</div>
                <div class="card-value large"><%= weather.humidity %>%</div>
            </div>
            <div class="bento-card wind-card">
                <div class="card-label">Wind Speed</div>
                <div class="card-value"><%= weather.windSpeed %> km/h</div>
            </div>
            <div class="bento-card pressure-card">
                <div class="card-label">Pressure</div>
                <div class="card-value"><%= weather.pressure %> hPa</div>
            </div>
            <div class="bento-card clouds-card">
                <div class="card-label">Cloudiness</div>
                <div class="card-value"><%= weather.clouds %>%</div>
            </div>
            <div class="bento-card visibility-card">
                <div class="card-label">Visibility</div>
                <div class="card-value"><%= (weather.visibility / 1000).toFixed(1) %> km</div>
            </div>
            <div class="bento-card minmax-card">
                <div class="minmax-item">
                    <div class="minmax-temp"><%= weather.min_temp %>°</div>
                    <div class="minmax-label">Min Temp</div>
                </div>
                <div class="minmax-item">
                    <div class="minmax-temp"><%= weather.max_temp %>°</div>
                    <div class="minmax-label">Max Temp</div>
                </div>
            </div>
            <div class="bento-card sunrise-card">
                <div class="card-label">Sunrise</div>
                <div class="card-value"><%= weather.sunrise %></div>
            </div>
            <div class="bento-card sunset-card">
                <div class="card-label">Sunset</div>
                <div class="card-value"><%= weather.sunset %></div>
            </div>
        </div>
        <% } else if (error) { %>
        <div class="error"><%= error %></div>
        <% } %>
    </div>
</body>
</html>
