<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather App</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 1rem;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding-top: 2rem;
            animation: fadeInUp 0.8s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .search-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            animation: slideInDown 0.6s ease-out 0.2s both;
        }

        @keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .search-form {
            display: flex;
            gap: 0.75rem;
        }

        .search-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: none;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .search-input::placeholder { 
            color: rgba(255, 255, 255, 0.7); 
            transition: all 0.3s ease;
        }
        
        .search-input:focus { 
            background: rgba(255, 255, 255, 0.3); 
            transform: scale(1.02);
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.2);
        }

        .search-btn {
            padding: 1rem;
            border: none;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .search-btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            transition: all 0.5s ease;
            transform: translate(-50%, -50%);
        }

        .search-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.05) rotate(5deg);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .search-btn:hover::before {
            width: 100px;
            height: 100px;
        }

        .search-btn:active {
            transform: scale(0.95);
        }

        .bento-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(4, minmax(140px, auto));
            gap: 1rem;
            grid-template-areas:
                "main main temp temp"
                "main main feels humidity"
                "wind pressure clouds visibility"
                "sunrise sunset minmax minmax";
            animation: staggeredFadeIn 0.8s ease-out 0.4s both;
        }

        @keyframes staggeredFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .bento-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 1.5rem;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            opacity: 0;
            transform: translateY(30px) scale(0.95);
            animation: cardAppear 0.6s ease-out forwards;
        }

        @keyframes cardAppear {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .bento-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transform: rotate(45deg);
            transition: all 0.6s ease;
            opacity: 0;
        }

        .bento-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .bento-card:hover::before {
            opacity: 1;
            transform: rotate(45deg) translate(50%, 50%);
        }

        /* Staggered animation delays for cards */
        .main-weather { grid-area: main; animation-delay: 0.1s; }
        .temp-card { grid-area: temp; animation-delay: 0.2s; }
        .feels-card { grid-area: feels; animation-delay: 0.3s; }
        .humidity-card { grid-area: humidity; animation-delay: 0.4s; }
        .wind-card { grid-area: wind; animation-delay: 0.5s; }
        .pressure-card { grid-area: pressure; animation-delay: 0.6s; }
        .clouds-card { grid-area: clouds; animation-delay: 0.7s; }
        .visibility-card { grid-area: visibility; animation-delay: 0.8s; }
        .sunrise-card { grid-area: sunrise; animation-delay: 0.9s; }
        .sunset-card { grid-area: sunset; animation-delay: 1.0s; }
        .minmax-card { grid-area: minmax; animation-delay: 1.1s; }

        .main-weather {
            text-align: center;
            justify-content: center;
            align-items: center;
        }

        .city-name {
            font-size: 1.8rem;
            font-weight: 500;
            margin-bottom: 1rem;
            opacity: 0.9;
        }

        .weather-icon-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin: 1rem 0;
        }

        .weather-icon {
            width: 100px;
            height: 100px;
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .weather-description {
            font-size: 1.3rem;
            font-weight: 400;
            text-transform: capitalize;
        }

        .temp-card {
            text-align: center;
            justify-content: center;
        }

        .main-temp {
            font-size: 3.5rem;
            font-weight: 200;
            line-height: 1;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .temp-label {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-top: 0.5rem;
        }

        .card-label {
            font-size: 0.85rem;
            opacity: 0.8;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-value {
            font-size: 1.4rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .card-value.large {
            font-size: 2rem;
            transition: all 0.3s ease;
        }

        .bento-card:hover .card-value {
            transform: scale(1.1);
            color: rgba(255, 255, 255, 0.9);
        }

        .minmax-card {
            flex-direction: row;
            align-items: center;
            gap: 2rem;
        }

        .minmax-item {
            flex: 1;
            text-align: center;
        }

        .minmax-temp {
            font-size: 1.8rem;
            font-weight: 500;
            margin-bottom: 0.25rem;
        }

        .minmax-label {
            font-size: 0.85rem;
            opacity: 0.8;
        }

        .error {
            background: rgba(255, 107, 107, 0.1);
            border: 1px solid rgba(255, 107, 107, 0.3);
            border-radius: 20px;
            padding: 2rem;
            color: #ff6b6b;
            text-align: center;
            font-size: 1.1rem;
            backdrop-filter: blur(20px);
            animation: shake 0.5s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        @media (max-width: 768px) {
            .bento-grid {
                grid-template-columns: repeat(2, 1fr);
                grid-template-rows: repeat(6, minmax(120px, auto));
                grid-template-areas:
                    "main main"
                    "temp feels"
                    "humidity wind"
                    "pressure clouds"
                    "visibility minmax"
                    "sunrise sunset";
            }
            
            .weather-icon { width: 80px; height: 80px; }
            .main-temp { font-size: 2.8rem; }
            .city-name { font-size: 1.4rem; }
        }

        @media (max-width: 480px) {
            .container { padding-top: 1rem; }
            .bento-grid {
                grid-template-columns: 1fr;
                grid-template-areas:
                    "main"
                    "temp"
                    "minmax"
                    "feels"
                    "humidity"
                    "wind"
                    "pressure"
                    "clouds"
                    "visibility"
                    "sunrise"
                    "sunset";
            }
            
            .minmax-card { flex-direction: row; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="search-card">
            <form class="search-form" action="/weather" method="get">
                <input type="text" name="city" class="search-input" placeholder="Enter city name..." required>
                <button type="submit" class="search-btn">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                </button>
            </form>
        </div>

        <% if (weather) { %>
        <div class="bento-grid">
            <!-- Main Weather Card -->
            <div class="bento-card main-weather">
                <div class="city-name"><%= weather.city %>, <%= weather.country %></div>
                <div class="weather-icon-row">
                    <img src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png" 
                         alt="<%= weather.description %>" class="weather-icon">
                    <div class="weather-description"><%= weather.description %></div>
                </div>
            </div>

            <!-- Temperature Card -->
            <div class="bento-card temp-card">
                <div class="card-label">Temperature</div>
                <div class="main-temp"><%= weather.temp %>°</div>
                <div class="temp-label">Celsius</div>
            </div>

            <!-- Feels Like Card -->
            <div class="bento-card feels-card">
                <div class="card-label">Feels Like</div>
                <div class="card-value large"><%= weather.feels_like %>°</div>
            </div>

            <!-- Humidity Card -->
            <div class="bento-card humidity-card">
                <div class="card-label">Humidity</div>
                <div class="card-value large"><%= weather.humidity %>%</div>
            </div>

            <!-- Wind Card -->
            <div class="bento-card wind-card">
                <div class="card-label">Wind Speed</div>
                <div class="card-value"><%= weather.windSpeed %> km/h</div>
            </div>

            <!-- Pressure Card -->
            <div class="bento-card pressure-card">
                <div class="card-label">Pressure</div>
                <div class="card-value"><%= weather.pressure %> hPa</div>
            </div>

            <!-- Clouds Card -->
            <div class="bento-card clouds-card">
                <div class="card-label">Cloudiness</div>
                <div class="card-value"><%= weather.clouds %>%</div>
            </div>

            <!-- Visibility Card -->
            <div class="bento-card visibility-card">
                <div class="card-label">Visibility</div>
                <div class="card-value"><%= (weather.visibility / 1000).toFixed(1) %> km</div>
            </div>

            <!-- Min/Max Temperature Card -->
            <div class="bento-card minmax-card">
                <div class="minmax-item">
                    <div class="minmax-temp"><%= weather.min_temp %>°</div>
                    <div class="minmax-label">Min Temp</div>
                </div>
                <div class="minmax-item">
                    <div class="minmax-temp"><%= weather.max_temp %>°</div>
                    <div class="minmax-label">Max Temp</div>
                </div>
            </div>

            <!-- Sunrise Card -->
            <div class="bento-card sunrise-card">
                <div class="card-label">Sunrise</div>
                <div class="card-value"><%= weather.sunrise %></div>
            </div>

            <!-- Sunset Card -->
            <div class="bento-card sunset-card">
                <div class="card-label">Sunset</div>
                <div class="card-value"><%= weather.sunset %></div>
            </div>
        </div>
        <% } else if (error) { %>
        <div class="error"><%= error %></div>
        <% } %>
    </div>
</body>
</html>
