<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Weather App</title>
  <style>
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #f4f4f4;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .card {
      background: #1e1e1e;
      color: #fff;
      border-radius: 16px;
      padding: 2rem;
      max-width: 500px;
      width: 100%;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .search {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .search input {
      flex: 1;
      padding: 0.75rem 1rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
    }

    .search button {
      width: 44px;
      height: 44px;
      border: none;
      border-radius: 50%;
      background: #ff7a7a;
      color: #000;
      cursor: pointer;
      transition: background 0.3s;
    }

    .search button:hover {
      background: #7fbdff;
    }

    .weather {
      text-align: center;
    }

    .weather h1 {
      font-size: 3rem;
      margin: 0.2em 0;
    }

    .weather .city {
      font-size: 1.5rem;
      margin-bottom: 0.5em;
    }

    .flex {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin: 1rem 0;
    }

    .flex img {
      width: 64px;
      height: 64px;
    }

    .description {
      text-transform: capitalize;
      font-size: 1.2rem;
    }

    .details {
      display: grid;
      gap: 0.75rem;
      margin-top: 1.5rem;
      font-size: 0.95rem;
    }

    .details div {
      background: #2a2a2a;
      padding: 0.75rem 1rem;
      border-radius: 8px;
    }

    .error {
      color: red;
      margin-top: 1rem;
      text-align: center;
    }

    @media (max-width: 500px) {
      .card {
        border-radius: 0;
        padding: 1.5rem 1rem;
      }

      .weather h1 {
        font-size: 2.2rem;
      }
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="search">
      <form action="/weather" method="get" style="display:flex; width: 100%;">
        <input name="city" type="text" placeholder="City, State or Country" required />
        <button type="submit">
          🔍
        </button>
      </form>
    </div>

    <% if (weather) { %>
    <div class="weather">
      <div class="city">Weather in <%= weather.city %>, <%= weather.country %></div>
      <h1><%= weather.temp %>°C</h1>

      <div class="flex">
        <img src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png" alt="<%= weather.description %>"/>
        <div class="description"><%= weather.description %></div>
      </div>

      <div class="details">
        <div>Feels Like: <%= weather.feels_like %>°C</div>
        <div>Min Temp: <%= weather.min_temp %>°C</div>
        <div>Max Temp: <%= weather.max_temp %>°C</div>
        <div>Humidity: <%= weather.humidity %>%</div>
        <div>Pressure: <%= weather.pressure %> hPa</div>
        <div>Wind: <%= weather.windSpeed %> km/h, <%= weather.windDeg %>°</div>
        <div>Cloudiness: <%= weather.clouds %>%</div>
        <div>Visibility: <%= weather.visibility / 1000 %> km</div>
        <div>Sunrise: <%= weather.sunrise %></div>
        <div>Sunset: <%= weather.sunset %></div>
        <div>Coordinates: [Lat: <%= weather.lat %>, Lon: <%= weather.lon %>]</div>
      </div>
    </div>
    <% } else if (error) { %>
    <div class="error"><%= error %></div>
    <% } %>
  </div>
</body>
</html>
